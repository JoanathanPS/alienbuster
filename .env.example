# -----------------------------------------------------------------------------
# AlienBuster - Unified Environment Configuration Template
# Copy this file to `.env` in the root directory:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# Frontend (Vite / Vercel)
# Public variables prefixed with VITE_ are bundled and available in the browser:
VITE_API_BASE=http://127.0.0.1:8000
VITE_HUGGINGFACE_API_KEY=your-huggingface-token-here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Backend (FastAPI)
# Vision Model: "huggingface" (cloud inference) or "heuristic" (fast offline)
VISION_MODEL_MODE=huggingface
HUGGINGFACE_API_KEY=your-huggingface-token-here

# Storage: defaults to SQLite (set SUPABASE_SERVICE_ROLE_KEY only if admin access needed)
LOCAL_REPORTS_DB=backend/local_reports.sqlite
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Earth Engine & Alerts (optional)
EARTH_ENGINE_PROJECT=alien-buster
ALERT_ENABLED=false
ALERT_SENDER_EMAIL=
ALERT_APP_PASSWORD=
ALERT_RECIPIENTS=
ALERT_RISK_THRESHOLD=0.75
