# Copy to .env or (recommended) .env.local and fill in your Supabase project values.
# Vite exposes variables prefixed with VITE_ to the browser.


# Base URL for the local Python backend
# Example: http://127.0.0.1:8000
VITE_API_BASE="http://127.0.0.1:8000"

# Backwards compatible (older code):
VITE_API_BASE_URL="http://127.0.0.1:8000"

# -- Supabase/frontend ----------------------------------------------------
# Project identifiers generated by Supabase. anyone can see the public key.
VITE_SUPABASE_PROJECT_ID="zqkjatpbnqsyugtfokkg"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inpxa2phdHBibnFzeXVndGZva2tnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE2Njc0MjQsImV4cCI6MjA4NzI0MzQyNH0.qz4-ZKnn_SyeSmKjHWVt2k5YpRHADa0Qe9Smc9FfZAI"
VITE_SUPABASE_URL="https://zqkjatpbnqsyugtfokkg.supabase.co"

# -- Supabase/backend (optional, leave blank for SQLite development) ------
# these values are used by the Python service and must be kept secret
SUPABASE_URL="https://zqkjatpbnqsyugtfokkg.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your service-role key>"

